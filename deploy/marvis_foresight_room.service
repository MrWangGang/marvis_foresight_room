[Unit]
Description=Marvis Foresight Room
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/depoly/marvis_foresight_room
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/root/depoly/marvis_foresight_room/.env
ExecStart=/root/depoly/marvis_foresight_room/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 18084 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
